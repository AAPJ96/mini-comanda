<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Renglón 1: Folio (rojo), Fecha (negro), Estado (gris) -->
        <TextView
            android:id="@+id/tv_folio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="C-001"
            android:textColor="@color/pill_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_fecha" />

        <TextView
            android:id="@+id/tv_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25/03/2025"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/tv_folio"
            app:layout_constraintTop_toTopOf="@+id/tv_folio"
            app:layout_constraintEnd_toStartOf="@+id/tv_estado" />

        <TextView
            android:id="@+id/tv_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVA"
            android:textColor="@color/pill_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Renglón 2: Nombre cliente + tipo de pedido -->
        <TextView
            android:id="@+id/tv_cliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gorra azul"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_folio"
            app:layout_constraintEnd_toStartOf="@+id/tv_tipo_pedido" />

        <TextView
            android:id="@+id/tv_tipo_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comer aquí"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_cliente" />

        <!-- Contenedor del desglose (colapsable) -->
        <LinearLayout
            android:id="@+id/layout_detalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_cliente"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_detalle_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Persona 1  $150\n5 x Taco Carne Maiz $125\n1 x frijoles 1/4 Lt $25\n\nPersona 2 $54\n3 x Taco Papa Maiz $54\n\nTotal Pedido $204"
                android:textColor="@android:color/black"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Renglón de botones (siempre visibles) -->
        <LinearLayout
            android:id="@+id/layout_botones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/layout_detalles"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_editar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Editar"
                android:backgroundTint="@color/header_background"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_eliminar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Eliminar"
                android:backgroundTint="@color/pill_text"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>